# ============================================================================
#  Simulation environment — ready to run, no secrets to fill in.
# ============================================================================
#  Every value here is deliberately fake and safe to commit. The keys below are
#  Anvil's published test keys: they are known to the whole internet and must
#  never appear in .env.prod. scripts/preflight_check.sh refuses to launch
#  production if it finds them.
#
#  This file is the mirror image of .env.prod.example: same variables, same
#  meaning, values that work out of the box.
# ============================================================================

GATEWAY_MODE=simulation
ENVIRONMENT=development

# ── Infrastructure ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=simulation_pg_password
REDIS_PASSWORD=simulation_redis_password
DATABASE_URL=postgresql+asyncpg://gateway:simulation_pg_password@gateway-postgres:5432/gateway_db
DATABASE_SSL=false
REDIS_URL=redis://:simulation_redis_password@gateway-redis:6379/0
CELERY_BROKER_URL=redis://:simulation_redis_password@gateway-redis:6379/0
# Migrations, exactly as production does. Letting the application create its own
# schema here made the simulation unfaithful on the axis that matters most for a
# deploy: create_all built tables that Alembic then refused to create again, so
# the migration path was only ever exercised in production.
AUTO_CREATE_SCHEMA=false

# ── Vault (dev mode: auto-unsealed) ─────────────────────────────────────────
VAULT_ADDR=http://gateway-vault:8200
VAULT_TOKEN=simulation-root-token

# ── Bank acquirer: the ISO 8583 simulator ───────────────────────────────────
BANK_HOST=bank-simulator
BANK_PORT=9000
BANK_USE_TLS=false
BANK_TLS_INSECURE=false
BANK_TIMEOUT_SEC=10
BANK_ECHO_INTERVAL_SEC=60
ACQUIRER_TERMINAL_ID=SIMTERM1
ACQUIRER_MERCHANT_ID=SIMULATOR000001
ACQUIRER_CURRENCY=840
ACQUIRER_POS_DATA=010
ACQUIRER_PROCESSING_CODE=000000
ACQUIRER_SEND_CVV=true
ACQUIRER_HEX_BITMAP=false
# Blank means "use the dialect's own encoding" rather than overriding it.
ACQUIRER_ENCODING=
# Field lengths, encoding and bitmap form as one coherent profile.
ACQUIRER_DIALECT=iso87
# Mandatory fields, per Worldpay's published reference guide.
ACQUIRER_INSTITUTION_ID=12345678901
# DE43 built positionally from its parts, not as one opaque blob.
ACQUIRER_NAME=SIMULATION GATEWAY
ACQUIRER_CITY=PARIS
ACQUIRER_STATE=
ACQUIRER_COUNTRY_ALPHA=FR
# DE25: 59 identifies the transaction as electronic commerce.
ACQUIRER_POS_CONDITION=59
ACQUIRER_NAME_LOCATION=
ACQUIRER_MERCHANT_CATEGORY=6051

# ── Web3: the local Anvil chain ─────────────────────────────────────────────
WEB3_RPC_URL=http://gateway-anvil:8545
WEB3_CHAIN_ID=31337
# Anvil mines every second, so three confirmations cost three seconds.
WEB3_CONFIRMATIONS=3
WEB3_RECEIPT_TIMEOUT_SEC=60
WEB3_CONFIRMATION_TIMEOUT_SEC=120
# Anvil account #1. A published test key with no value on any real network.
WEB3_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Deterministic address of the first contract deployed by Anvil account #0.
ERC20_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Le stack de simulation tourne sur une chaîne locale sans oracle Chainlink,
# donc taux fixe ici. La production lit les flux on-chain.
# Les oracles sont lus sur le vrai mainnet — c'est gratuit et sans effet de
# bord — tandis que les transferts se règlent sur la chaîne locale. C'est ce
# qui permet d'exercer le chemin de cotation réel à travers tout le stack.
RATE_SOURCE=chainlink
RATE_RPC_URL=https://ethereum-rpc.publicnode.com
RATE_TOKEN_SYMBOL=USDT
RATE_SETTLEMENT_CURRENCY=USD
RATE_SPREAD=0.01
RATE_CROSS_CHECK_SOURCE=coingecko
RATE_CROSS_CHECK_TOLERANCE=0.02
RATE_CACHE_SECONDS=30
EXCHANGE_RATE=1.0

# ── Gateway security ────────────────────────────────────────────────────────
GATEWAY_API_KEY=simulation-api-key-not-a-secret
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
TRUSTED_PROXIES=*
AMOUNT_MIN=1.00
AMOUNT_MAX=10000.00
PAN_ENCRYPTION_KEY=simulation-pan-encryption-key-not-a-secret

# ── Safety behaviour ────────────────────────────────────────────────────────
# Fail-open in simulation so a stopped Redis does not block experimentation.
# Production fails closed.
CIRCUIT_BREAKER_FAIL_CLOSED=false
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SEC=30
PAN_TOKEN_TTL_SEC=86400
RECONCILIATION_INTERVAL_SEC=300
STALE_TRANSACTION_MINUTES=5

# Autorisation puis capture : la carte est retenue, débitée après livraison.
ACQUIRER_CAPTURE_MODE=auth_capture

# ── Fiat leg: acquirer route ────────────────────────────────────────────────
# Which backend serves the fiat leg of a payment.
#   iso8583    existing ISO 8583 link (BANK_* / ACQUIRER_* above) — the gateway
#              holds the hot wallet and settles the crypto itself. Default
#              here; the simulation stack runs exactly this path.
#   paymegate  PayMeGate's hosted checkout — the customer pays on PayMeGate's
#              page and PayMeGate settles the crypto straight to the wallet you
#              configured in PUT /v1/wallet. Everything in the Bank acquirer
#              and Web3 blocks above is bypassed in this mode.
ACQUIRER=iso8583

# ── PayMeGate (only read when ACQUIRER=paymegate) ───────────────────────────
# Leave these unset in simulation unless you want to exercise the PayMeGate
# driver against a sandbox. Never put a real pmg_live_ key in a committed file.
#PAYMEGATE_BASE_URL=https://api.paymegate.com
#PAYMEGATE_API_KEY=
#PAYMEGATE_WEBHOOK_SECRET=
#PAYMEGATE_PAYMENT_METHODS=*
# The customer returns here after paying on the hosted checkout (public HTTPS).
#PAYMEGATE_RETURN_URL=https://app.yourdomain.com/return
