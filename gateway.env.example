# ============================================================================
# 2D Link Fiat-to-Crypto Gateway — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values before running podman-compose.
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=gateway_db

# Connection string used by the application (points to the postgres container)
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME_IN_PRODUCTION@postgres:5432/gateway_db

# ── Redis (Celery Broker) ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0

# ── Blockchain (Web3) ─────────────────────────────────────────────────────
# RPC endpoint (Infura, Alchemy, or your own node)
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# ERC20 Token contract address (default: USDT on Ethereum mainnet)
ERC20_TOKEN_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ── HashiCorp Vault ────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME_ROOT_TOKEN

# ── Gateway API ────────────────────────────────────────────────────────────
# API Key for authenticating clients. Leave empty to disable auth.
GATEWAY_API_KEY=sk_live_CHANGE_ME

# ── Bank Network (ISO8583) ─────────────────────────────────────────────────
# In production, point to your real acquirer host.
# In dev, the bank-simulator container listens on bank-simulator:9000
BANK_HOST=bank-simulator
BANK_PORT=9000
