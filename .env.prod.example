# ============================================================================
#  Production environment — copy to .env.prod and fill in every REPLACE_ME.
# ============================================================================
#  This file is the mirror image of .env.sim: identical variables, identical
#  meaning. Everything you cannot know until the external pieces exist (the
#  acquirer, the RPC provider, the certificates) is marked REPLACE_ME.
#
#  `make prod-preflight` refuses to launch while any REPLACE_ME remains, and
#  also refuses simulation leftovers — test chains, published Anvil keys, a
#  plaintext acquirer link, CORS set to '*'.
#
#  Never commit .env.prod. Keep it at 0600 and back it up somewhere your
#  secret manager controls.
# ============================================================================

GATEWAY_MODE=production
ENVIRONMENT=production

# ── Infrastructure ──────────────────────────────────────────────────────────
#  Used by podman-compose.prod.yml to provision Postgres and Redis, and by the
#  URLs below. Generate both with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

DATABASE_URL=postgresql+asyncpg://gateway:REPLACE_ME_POSTGRES_PASSWORD@gateway-postgres:5432/gateway_db
DATABASE_SSL=true
REDIS_URL=redis://:REPLACE_ME_REDIS_PASSWORD@gateway-redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_ME_REDIS_PASSWORD@gateway-redis:6379/0

# The schema is applied by a migration step, not by the application.
AUTO_CREATE_SCHEMA=false

# ── HashiCorp Vault ─────────────────────────────────────────────────────────
#  Production Vault does not auto-unseal. After every restart of the Vault
#  container someone must run `make prod-vault-unseal` with the unseal key
#  printed at initialisation. Plan for that in your runbook.
VAULT_ADDR=http://gateway-vault:8200
VAULT_TOKEN=REPLACE_ME_VAULT_TOKEN

# ── Bank acquirer (ISO 8583) ────────────────────────────────────────────────
#  Everything in this block comes from your acquirer's implementation guide.
BANK_HOST=REPLACE_ME_ACQUIRER_HOST
BANK_PORT=REPLACE_ME_ACQUIRER_PORT
BANK_USE_TLS=true
# Must stay false: true disables certificate verification on a link carrying
# card data.
BANK_TLS_INSECURE=false
# Leave blank to use the system trust store.
BANK_TLS_CA_FILE=
# Mutual TLS, if your acquirer issues you a client certificate.
BANK_TLS_CLIENT_CERT=
BANK_TLS_CLIENT_KEY=
BANK_TIMEOUT_SEC=10
BANK_ECHO_INTERVAL_SEC=60

# Card acceptor identification. An acquirer declines a 0200 without these.
ACQUIRER_TERMINAL_ID=REPLACE_ME_TERMINAL_ID
ACQUIRER_MERCHANT_ID=REPLACE_ME_MERCHANT_ID
# ISO 4217 numeric. 840=USD, 978=EUR, 826=GBP.
ACQUIRER_CURRENCY=840
ACQUIRER_COUNTRY=840
# DE22, point of service ENTRY MODE. n3 in the ISO 8583:1987 dialects, n4 for
# Visa — not the twelve-character point-of-service *data code*, which is a
# different Mastercard field. Leave blank to take the dialect's default.
#   010  / 0100  manual PAN entry, no PIN capability (card-not-present)
ACQUIRER_POS_DATA=

# Which variant your acquirer's host speaks. This sets field lengths, character
# encoding and bitmap form together — they are not independent choices, and the
# wrong combination is rejected outright rather than degraded. Ask them.
#   iso87        ISO 8583:1987 baseline, DE22 n3, ASCII
#   visa_base1   Visa BASE I, DE22 n4, EBCDIC
#   worldpay     Worldpay's published guide, DE22 n4, ASCII
ACQUIRER_DIALECT=iso87

# Blank uses the dialect's own encoding. Override only if your acquirer differs.
ACQUIRER_ENCODING=

# Mandatory in an authorisation, per Worldpay's reference guide. All three are
# assigned by your acquirer; preflight refuses to start without them.
#   DE32, acquiring institution identification code
ACQUIRER_INSTITUTION_ID=REPLACE_ME_INSTITUTION_ID
#   DE43, card acceptor name and location. Built from these parts rather than
#   as one forty-character string: the field is strictly positional
#   (1-23 name, 24-36 city, 37-38 state, 39-40 country) and a blob that is off
#   by a character puts the city inside the merchant name. Nothing rejects it,
#   and the cardholder reads the result on their statement.
ACQUIRER_NAME=REPLACE_ME_MERCHANT_NAME
ACQUIRER_CITY=REPLACE_ME_CITY
ACQUIRER_STATE=
#   Two-letter country code. Distinct from ACQUIRER_COUNTRY, which is numeric.
ACQUIRER_COUNTRY_ALPHA=US
#   Set this only if you build DE43 yourself; it overrides the parts above.
ACQUIRER_NAME_LOCATION=

# DE25, point of service condition code. 59 identifies the transaction as
# electronic commerce, which drives interchange rate and chargeback liability.
# Omitting it does not fail loudly — it prices the transaction as something
# other than what it is.
#   59  electronic commerce      01  customer not present
#   08  mail/telephone order
ACQUIRER_POS_CONDITION=59
#   DE18, merchant category code. 6051 is the usual quasi-cash code for crypto
#   purchases, but the acquirer assigns it — confirm before going live.
ACQUIRER_MERCHANT_CATEGORY=6051
ACQUIRER_PROCESSING_CODE=000000
# CVV2 is carried in a DE48 subelement whose number is acquirer-specific.
# See src/gateway/acquirer.py (`PDS0052`) before going live.
ACQUIRER_SEND_CVV=true

# How money is taken. This is the most consequential setting in the file.
#
#   auth_capture  A 0100 places a hold, the crypto is delivered, then a 0220
#                 takes the money. A delivery failure releases the hold: the
#                 cardholder sees a pending amount disappear, and is never owed
#                 a refund that could be refused.
#   purchase      A 0200 takes the money up front. Every failure after it needs
#                 a reversal, and a refused reversal leaves a cardholder out of
#                 pocket with only a manual refund to fix it.
#
# Use purchase only if your acquirer cannot separate authorisation and capture.
# Confirm with them that 0100/0110, 0220/0230 and 0420/0430 are supported, and
# how long an uncaptured hold survives — usually about seven days.
ACQUIRER_CAPTURE_MODE=auth_capture
# Wire format. Both are valid ISO 8583; which one your acquirer expects is part
# of their dialect, and the wrong choice means every message is rejected as
# unparseable. Ask for their specification — do not guess.
#   ACQUIRER_HEX_BITMAP=false  16 raw bytes  (the common case)
#   ACQUIRER_HEX_BITMAP=true   32 hex characters
ACQUIRER_HEX_BITMAP=false
# latin_1 for ASCII hosts, cp500 for EBCDIC ones (mainframe-backed acquirers).
ACQUIRER_ENCODING=latin_1

# ── Web3 ────────────────────────────────────────────────────────────────────
WEB3_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME_ALCHEMY_KEY
WEB3_RPC_URL_BACKUP=https://mainnet.infura.io/v3/REPLACE_ME_INFURA_KEY
# Mandatory in production: the gateway refuses to sign against another chain.
# 1=Ethereum mainnet, 137=Polygon, 42161=Arbitrum One.
WEB3_CHAIN_ID=1
WEB3_CONFIRMATIONS=3
WEB3_RECEIPT_TIMEOUT_SEC=180
WEB3_CONFIRMATION_TIMEOUT_SEC=600
# Token contract. The default is USDT on Ethereum mainnet — change it if you
# settle in a different asset, and check its decimals.
ERC20_TOKEN_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
# ── Exchange rate ───────────────────────────────────────────────────────────
# Where the rate comes from. "chainlink" reads the on-chain oracles over the
# Web3 connection the gateway already holds — no API key, no extra service to
# keep alive. "fixed" uses EXCHANGE_RATE below and is correct only for a
# stablecoin at parity.
RATE_SOURCE=chainlink
EXCHANGE_RATE=1.0

# Written FIAT/TOKEN: the currency taken, and the token delivered. A pair with
# no direct oracle is crossed through the settlement currency — EUR/USDT is
# read as (USDT/USD) / (EUR/USD).
# The token delivered. The pair is built per transaction from the currency the
# customer pays in, so one deployment serves USD, EUR and GBP alike.
RATE_TOKEN_SYMBOL=USDT
RATE_SETTLEMENT_CURRENCY=USD

# RPC used for reading price oracles. Leave blank to reuse the signing RPC.
#
# Worth separating for two reasons. Reading a feed is free and changes nothing,
# so it does not need the provider tier that signing does — and a rate lookup
# then has no path to the key at all. It also lets prices come from mainnet
# while settlement happens elsewhere, which is how the live rate path is
# exercised without moving real value.
RATE_RPC_URL=

# A public endpoint is adequate for reading feeds, but rate limits apply and a
# busy gateway will meet them. RATE_CACHE_SECONDS above is what keeps the
# request count down; a paid endpoint is the answer if it is not enough.

# Margin over mid-market. Never quote mid: every payment would then be a coin
# flip on which way the market moved between the quote and the transfer, with
# nothing to absorb the losing half.
RATE_SPREAD=0.01

# A quote is refused if the rate moved more than this since the last one. A
# sharp market move and a broken oracle are indistinguishable from here, and
# only one of them is safe to deliver against.
RATE_MAX_MOVEMENT=0.10

# Multiplier on each feed's heartbeat to decide staleness. Above 1 by design:
# forex feeds publish on a 24-hour heartbeat when the price is stable, so a
# threshold below it would reject readings that are working exactly as intended
# and refuse every payment while nothing is wrong.
RATE_STALENESS_MARGIN=1.5
# Per-pair overrides in seconds, e.g. "EUR/USD:129600,USDT/USD:129600".
RATE_STALENESS_OVERRIDES=

# Plausible ranges, "PAIR:low:high". Wide enough that ordinary volatility
# passes and a decimal-place error does not — a feed ten times too low sends
# ten times the tokens.
RATE_BOUNDS=USDT/USD:0.5:1.5,EUR/USD:0.5:2.0,GBP/USD:0.5:2.5

# A second, independent source. Advisory: material disagreement refuses the
# quote, but its downtime does not stop payments the oracle can price.
# "none" runs on the oracle alone.
RATE_CROSS_CHECK_SOURCE=coingecko
RATE_CROSS_CHECK_TOLERANCE=0.02

# How long a verified quote is reused, in seconds.
RATE_CACHE_SECONDS=30

# The hot wallet's private key belongs in Vault at secret/gateway/web3, not
# here. Leave this blank in production; it exists only for local runs.
WEB3_PRIVATE_KEY=

# ── Gateway security ────────────────────────────────────────────────────────
# openssl rand -hex 32
GATEWAY_API_KEY=REPLACE_ME_API_KEY
# Comma-separated. '*' is refused in production.
CORS_ORIGINS=https://app.yourdomain.com
RATE_LIMIT_PER_MINUTE=5
# Whose X-Forwarded-For the gateway believes. Refused at '*' in production:
# the rate limit is keyed on this value, so a wildcard lets any client pick its
# own identity and RATE_LIMIT_PER_MINUTE stops meaning anything.
#
# Only Nginx reaches the API here, and its container address is assigned at
# start, so name the network rather than a host. 10.89.0.0/16 is podman's
# default pool for named networks; CIDR entries are supported (api.py).
#
# Pin it exactly once the stack has run at least once:
#   podman network inspect gateway-prod-frontend --format '{{range .Subnets}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=10.89.0.0/16
AMOUNT_MIN=1.00
AMOUNT_MAX=10000.00

# Encrypts the card number held for the duration of a possible reversal.
# Belongs in Vault at secret/gateway/pan; this is the fallback.
# Generate with: openssl rand -base64 32
PAN_ENCRYPTION_KEY=REPLACE_ME_PAN_ENCRYPTION_KEY
# How long a reversal stays possible. 24h covers a worker outage.
PAN_TOKEN_TTL_SEC=86400

# ── Safety behaviour ────────────────────────────────────────────────────────
# When Redis is unreachable the gateway cannot read the circuit breaker. In
# production it refuses payments rather than debit fiat it may not honour.
CIRCUIT_BREAKER_FAIL_CLOSED=true
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SEC=30

# Reconciliation runs in Celery Beat.
RECONCILIATION_INTERVAL_SEC=900
STALE_TRANSACTION_MINUTES=15

# ── Runtime sizing ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=4

# ── Published ports ─────────────────────────────────────────────────────────
# Standard ports assume a rootful deployment. Rootless podman cannot bind
# below 1024 — either raise net.ipv4.ip_unprivileged_port_start on the host,
# or set these high and redirect to them from the host's firewall.
HTTP_PORT=80
HTTPS_PORT=443

# Vault memory locking. false is correct and safest, but requires privileges a
# rootless container does not have. See the note in podman-compose.prod.yml.
VAULT_DISABLE_MLOCK=true
